# ChessBase Environment Configuration

# PostgreSQL Database Connection
# Standard local format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chessbase"

# JWT Authentication Secret (generate via: openssl rand -base64 32)
JWT_SECRET="chessbase_super_secret_jwt_key_2026_pes_dbms_level3"

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@chessbase.local"
ADMIN_PASSWORD="AdminPassword123!"

# Application Port
PORT=3000

# Optional Embedding API Key (Leave empty to use built-in local deterministic vector embedding)
EMBEDDING_API_KEY=""
EMBEDDING_PROVIDER="local"

